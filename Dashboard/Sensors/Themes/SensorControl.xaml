<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Simurgh.Dashboard.Sensors.Controls"
    xmlns:controls1="clr-namespace:Simurgh.Dashboard.Core.Controls"
    xmlns:converters="clr-namespace:Simurgh.Dashboard.Core.Infrastructures.Converters"
    xmlns:models="clr-namespace:Simurgh.Dashboard.Sensors.Models">

    <!--  Merged theme resource dictionaries  -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Simurgh.Dashboard;component/Core/Themes/Icons.xaml" />
        <ResourceDictionary Source="/Simurgh.Dashboard;component/Core/Themes/Fonts.xaml" />
        <ResourceDictionary Source="/Simurgh.Dashboard;component/Core/Themes/Images.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

    <!--  Example ItemTemplate consumption inside DigitalSensorControl  -->
    <DataTemplate x:Key="MeasurableValueItemTemplate">
        <controls:MeasurableValueControl
            ChannelIndex="{Binding ChannelIndex}"
            DigitBrush="{Binding StatusBrush}"
            IconData="{Binding Type, Converter={converters:SensorIconConverter}}"
            Label="{Binding Label}"
            PlaceholderBrush="{Binding PlaceholderBrush}"
            PlaceholderText="{Binding PlaceholderValue}"
            Unit="{Binding Unit}"
            ValueText="{Binding FormattedValue}" />
    </DataTemplate>

    <!--
        =====================================================================
        DIGITAL SENSOR CONTROL CONTAINER STYLE
        =====================================================================
        Card container providing module framing, title header, items list,
        and module operational state footer with decoupled 9-slice padding.
        =====================================================================
    -->
    <Style TargetType="{x:Type controls:SensorControl}">
        <!--  Dynamic user padding property passed down via TemplateBinding  -->
        <Setter Property="Padding" Value="30,10,30,30" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="#33FFFFFF" />
        <Setter Property="Background" Value="#CC000000" />
        <Setter Property="ItemTemplate" Value="{StaticResource MeasurableValueItemTemplate}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <WrapPanel
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:SensorControl}">
                    <!--  Root Container  -->
                    <Grid Margin="5" SnapsToDevicePixels="True">
                        <!--  LAYER 1: NineSlice Border Background Frame  -->
                        <controls1:NineSliceBorder
                            x:Name="PART_Frame"
                            Margin="-15"
                            IsHitTestVisible="False"
                            SliceThickness="60"
                            Source="{StaticResource ImgPanelRoundedRaised}" />


                        <Border
                            Padding="{TemplateBinding Padding}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}">

                            <!--  LAYER 4: Content Layout Rows Grid  -->
                            <Grid x:Name="PART_ContentGrid">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!--  SECTION A: HEADER  -->

                                <TextBlock
                                    Grid.Row="0"
                                    Margin="-4"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource FontFamilyApp}"
                                    FontSize="28"
                                    FontWeight="ExtraBold"
                                    Foreground="{TemplateBinding Foreground}"
                                    Text="{TemplateBinding HeaderText}"
                                    TextAlignment="Center"
                                    TextTrimming="CharacterEllipsis" />


                                <!--  SECTION B: MEASUREMENT LIST HOUSING (ITEMS DELEGATION)  -->
                                <Border
                                    Grid.Row="1"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="5">
                                    <ItemsControl
                                        Padding="10,0"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        ItemTemplate="{TemplateBinding ItemTemplate}"
                                        ItemTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                        ItemsPanel="{TemplateBinding ItemsPanel}"
                                        ItemsSource="{TemplateBinding ItemsSource}" />
                                </Border>

                                <!--  SECTION C: FOOTER STATUS INDICATOR  -->
                                <StackPanel
                                    x:Name="PART_StatePanel"
                                    Grid.Row="2"
                                    Margin="0,8,0,0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Visibility="{TemplateBinding IsStateVisible,
                                                                 Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock
                                        x:Name="PART_StateText"
                                        FontFamily="{StaticResource FontFamilyApp}"
                                        FontSize="16"
                                        FontWeight="ExtraBlack"
                                        Foreground="#4CAF50"
                                        Text="متصل" />
                                    <Ellipse
                                        x:Name="PART_StatusIndicator"
                                        Width="8"
                                        Height="8"
                                        Margin="6,0,0,0"
                                        VerticalAlignment="Center"
                                        Fill="#4CAF50" />
                                </StackPanel>
                            </Grid>
                        </Border>

                    </Grid>

                    <!--  STATE-DRIVEN VISUAL TRIGGERS  -->
                    <ControlTemplate.Triggers>
                        <Trigger Property="State" Value="{x:Static models:ModuleState.Offline}">
                            <Setter TargetName="PART_StateText" Property="Text" Value="ارتباط قطع" />
                            <Setter TargetName="PART_StateText" Property="Foreground" Value="#F44336" />
                            <Setter TargetName="PART_StatusIndicator" Property="Fill" Value="#F44336" />
                        </Trigger>
                        <Trigger Property="State" Value="{x:Static models:ModuleState.Warning}">
                            <Setter TargetName="PART_StateText" Property="Text" Value="هشدار" />
                            <Setter TargetName="PART_StateText" Property="Foreground" Value="#FFC107" />
                            <Setter TargetName="PART_StatusIndicator" Property="Fill" Value="#FFC107" />
                        </Trigger>
                        <Trigger Property="State" Value="{x:Static models:ModuleState.Error}">
                            <Setter TargetName="PART_StateText" Property="Text" Value="خطر" />
                            <Setter TargetName="PART_StateText" Property="Foreground" Value="#E91E63" />
                            <Setter TargetName="PART_StatusIndicator" Property="Fill" Value="#E91E63" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
