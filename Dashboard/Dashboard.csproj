<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Target platform, runtime framework, and WPF enablement -->
		<OutputType>WinExe</OutputType>
		<TargetFramework>net9.0-windows</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<StartupObject>Simurgh.Dashboard.App</StartupObject>
		<UseWPF>true</UseWPF>

		<!-- Assembly metadata and versioning -->
		<Version Condition="'$(Version)' == ''">1.0.11</Version>
		<Authors>Keyhan Babazadeh</Authors>
		<Company>Simurgh</Company>
		<Description>Simurgh Dashboard Client Application</Description>

		<!-- Velopack release orchestration variables -->
		<VelopackId>Simurgh.Dashboard</VelopackId>
		<Version>1.0.11</Version>
		<!-- Target destination for delta updates, full packages, and releases -->
		<VelopackReleaseDir Condition="'$(VelopackReleaseDir)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\Releases'))</VelopackReleaseDir>
		<BundleOutputDir Condition="'$(BundleOutputDir)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\Bundles'))</BundleOutputDir>		
		<RootNamespace>Simurgh.$(MSBuildProjectName.Replace(" ", "_"))</RootNamespace>
		<AssemblyName>Simurgh.$(MSBuildProjectName)</AssemblyName>
		<ApplicationIcon>Simurgh (Variant2) Black Circullar.ico</ApplicationIcon>
	</PropertyGroup>

	<!-- Excluded view and repository directories from compilation -->
	<ItemGroup>
