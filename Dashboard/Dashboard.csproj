	<!-- NuGet Package Dependencies -->
	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="9.0.20" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.20" />
		<PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.20" />
		<PackageReference Include="Microsoft.Extensions.Http" Version="9.0.20" />
		<PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="9.0.0" />
		<PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" Version="9.0.20" />
		<PackageReference Include="Microsoft.Xaml.Behaviors.Wpf" Version="1.1.142" />
		<PackageReference Include="NLog.Extensions.Logging" Version="6.2.0" />
		<PackageReference Include="StreamJsonRpc" Version="2.25.29" />
		<PackageReference Include="System.ServiceModel.Syndication" Version="9.0.20" />
		<!-- Velopack update manager and installer integration -->
		<PackageReference Include="Velopack" Version="1.2.158" />
	</ItemGroup>

	<!-- External Watchdog Assembly References -->

	<!-- Application Configuration Deployment -->
	<ItemGroup>
		<None Update="appsettings.json">
			<Generator></Generator>
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
		<None Update="NLog.config">
		  <CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
	</ItemGroup>

	<ItemGroup>
		<Folder Include="Watchdog\Options\" />
	</ItemGroup>

	<ItemGroup>
	  <Reference Include="Watchdog.Agent">
	    <HintPath>..\..\..\Simurgh-Watchdog\Application\Watchdog.Agent.Host\bin\Release\net9.0\Watchdog.Agent.dll</HintPath>
	  </Reference>
	  <Reference Include="Watchdog.Agent.Host">
	    <HintPath>..\..\..\Simurgh-Watchdog\Application\Watchdog.Agent.Host\bin\Release\net9.0\Watchdog.Agent.Host.dll</HintPath>
	  </Reference>
	  <Reference Include="Watchdog.Contracts">
	    <HintPath>..\..\..\Simurgh-Watchdog\Application\Watchdog.Agent.Host\bin\Release\net9.0\Watchdog.Contracts.dll</HintPath>
	  </Reference>
	</ItemGroup>

		<!-- Automated Velopack release packaging pipeline triggered post-publish in Release configuration -->
	<Target Name="VelopackAutoPack" AfterTargets="Publish" Condition="'$(Configuration)' == 'Release'">
		<PropertyGroup>
			<!-- Primary executable entrypoint for the packaged application -->
			<EntryExeName>$(TargetName).exe</EntryExeName>

			<!-- Releases and Bundles folder resolved -->
			<VelopackResolvedReleaseDir>$(VelopackReleaseDir.TrimEnd('\'))</VelopackResolvedReleaseDir>
			<BundleOutputDirResolved>$(BundleOutputDir.TrimEnd('\'))</BundleOutputDirResolved>
			<VelopackBundleZip>$(BundleOutputDirResolved)\$(VelopackId)-$(Version)-bundle.zip</VelopackBundleZip>
		</PropertyGroup>

		<Message Importance="High" Text="======================================================" />
		<Message Importance="High" Text="[Velopack] Starting packaging for $(VelopackId) v$(Version)..." />
		<Message Importance="High" Text="[Velopack] Source Directory: $(PublishDir)" />
		<Message Importance="High" Text="[Velopack] Release Directory: $(VelopackResolvedReleaseDir)" />
		<Message Importance="High" Text="[Velopack] Bundle Output Directory: $(BundleOutputDirResolved)" />
		<Message Importance="High" Text="======================================================" />

		<!-- Ensure target directories exist -->
		<MakeDir Directories="$(VelopackResolvedReleaseDir)" Condition="!Exists('$(VelopackResolvedReleaseDir)')" />
		<MakeDir Directories="$(BundleOutputDirResolved)" Condition="!Exists('$(BundleOutputDirResolved)')" />

		<!-- Execute Velopack CLI (vpk pack) to generate setup files, delta packages, and releases.win.json -->
		<Exec Command="vpk pack -u $(VelopackId) -v $(Version) -p &quot;$(PublishDir.TrimEnd('\'))&quot; -e $(EntryExeName) -o &quot;$(VelopackResolvedReleaseDir)&quot;" WorkingDirectory="$(MSBuildProjectDirectory)" />

		<!-- Package all release assets into a standalone zip bundle outside the release directory -->
		<ZipDirectory SourceDirectory="$(VelopackResolvedReleaseDir)" DestinationFile="$(VelopackBundleZip)" Overwrite="true" />

		<Message Importance="High" Text="======================================================" />
		<Message Importance="High" Text="[Velopack] Bundle Created Successfully: $(VelopackBundleZip)" />
		<Message Importance="High" Text="======================================================" />
	</Target>


</Project>
