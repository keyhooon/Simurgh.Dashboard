		<Compile Remove="Timers\Repositories\**" />
		<Compile Remove="Timers\Views\**" />
		<EmbeddedResource Remove="Sensors\Views\**" />
		<EmbeddedResource Remove="Timers\Repositories\**" />
		<EmbeddedResource Remove="Timers\Views\**" />
		<None Remove="Sensors\Views\**" />
		<None Remove="Timers\Repositories\**" />
		<None Remove="Timers\Views\**" />
		<Page Remove="Sensors\Views\**" />
		<Page Remove="Timers\Repositories\**" />
		<Page Remove="Timers\Views\**" />
		<ApplicationDefinition Remove="App.xaml" />
		<Page Include="App.xaml" SubType="Designer" Generator="MSBuild:Compile" />
	</ItemGroup>

	<!-- Items removed from default None items before being declared as WPF Resources -->
