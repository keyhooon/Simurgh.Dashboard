<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      throwConfigExceptions="false"
      internalLogLevel="Warn"
      internalLogFile="${tempdir}/nlog-internal.log">

	<targets>
		<!-- Rotating file log: keeps 7 days of history -->
		<target xsi:type="File"
		        name="file"
		        fileName="${specialfolder:folder=CommonApplicationData}/Simurgh/logs/simurgh-dashboard-${shortdate}.log"
		        layout="${longdate} | ${level:uppercase=true:padding=5} | ${logger} | ${message} ${exception:format=tostring}"
		        archiveEvery="Day"
		        archiveNumbering="Date"
		        maxArchiveFiles="7"
		        keepFileOpen="false"
		        encoding="utf-8" />

		<!-- Console target -->
		<target xsi:type="Console"
		        name="console"
		        layout="${time} | ${level:uppercase=true:padding=5} | ${logger:shortName=true} | ${message} ${exception:format=message}" />
	</targets>

	<rules>
		<!-- Suppress noisy framework logs -->
		<logger name="Microsoft.*" maxlevel="Info" final="true" />
		<logger name="System.Net.Http.*" maxlevel="Info" final="true" />

		<!-- Output to file & console -->
		<logger name="*" minlevel="Info" writeTo="file,console" />
	</rules>
</nlog>