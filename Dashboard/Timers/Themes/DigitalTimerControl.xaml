<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Simurgh.Dashboard.Core.Controls"
    xmlns:controls1="clr-namespace:Simurgh.Dashboard.Timers.Controls"
    xmlns:models="clr-namespace:Simurgh.Dashboard.Timers.Models">

    <!--  Merged theme resource dictionaries  -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Simurgh.Dashboard;component/Core/Themes/Icons.xaml" />
        <ResourceDictionary Source="/Simurgh.Dashboard;component/Core/Themes/Fonts.xaml" />
        <ResourceDictionary Source="/Simurgh.Dashboard;component/Core/Themes/Images.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

    <!--  DigitalTimerControl Style with clean nested grid architecture  -->
    <Style TargetType="{x:Type controls1:DigitalTimerControl}">
        <!--  Minimum baseline width for the entire control to avoid layout collapse inside ItemsControl/StackPanel  -->
        <Setter Property="MinWidth" Value="420" />
        <!--  Dynamic user padding property passed down via TemplateBinding  -->
        <Setter Property="Padding" Value="30,10,30,30" />
        <Setter Property="PlaceholderBrush" Value="#20263238" />
        <Setter Property="DigitBrush" Value="#63D7FF" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="#33FFFFFF" />
        <Setter Property="Background" Value="#CC000000" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls1:DigitalTimerControl}">
                    <!--  Root Container inheriting MinWidth from the control definition  -->
                    <Grid
                        MinWidth="{TemplateBinding MinWidth}"
                        Margin="5"
                        SnapsToDevicePixels="True">
                        <!--  LAYER 1: NineSlice Border Background Frame  -->
                        <controls:NineSliceBorder
                            x:Name="PART_Frame"
                            Margin="-15"
                            IsHitTestVisible="False"
                            SliceThickness="60"
                            Source="{StaticResource ImgPanelRoundedRaised}" />


                        <Border
                            Padding="{TemplateBinding Padding}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}">

                            <!--  LAYER 4: Content Layout Rows Grid  -->
                            <Grid x:Name="PART_ContentGrid">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!--  Section A: Title Header  -->

                                <TextBlock
                                    x:Name="PART_Title"
                                    Grid.Row="0"
                                    Margin="0,0,0,0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource FontFamilyApp}"
                                    FontSize="36"
                                    FontWeight="ExtraBold"
                                    Foreground="{TemplateBinding Foreground}"
                                    Text="{TemplateBinding Title}"
                                    TextAlignment="Center"
                                    TextTrimming="CharacterEllipsis" />


                                <!--  Section B: Digit & Segment Display Housing  -->
                                <Border
                                    Grid.Row="1"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="5">

                                    <Grid
                                        x:Name="PART_TimeContainer"
                                        Margin="14,6"
                                        ClipToBounds="False">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>

                                        <!--  Timer ID Badge  -->
                                        <Border
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            Margin="0,2,10,0"
                                            Padding="8,2"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4">
                                            <TextBlock
                                                x:Name="PART_Id"
                                                FontFamily="{StaticResource FontFamilyDigit}"
                                                FontSize="34"
                                                FontWeight="Heavy"
                                                Foreground="{TemplateBinding DigitBrush}"
                                                Text="{TemplateBinding Id}"
                                                TextAlignment="Center" />
                                        </Border>

                                        <!--  Telemetry Direction and State Vector Icons  -->
                                        <StackPanel
                                            Grid.Row="1"
                                            Grid.Column="0"
                                            Margin="0,4,8,2"
                                            VerticalAlignment="Bottom"
                                            Orientation="Horizontal">
                                            <Path
                                                x:Name="PART_DirectionIcon"
                                                Width="40"
                                                Height="40"
                                                Margin="0,0,4,0"
                                                VerticalAlignment="Center"
                                                Data="{StaticResource IconTimerDown}"
                                                Fill="{TemplateBinding DigitBrush}"
                                                Stretch="Uniform" />
                                            <Path
                                                x:Name="PART_StateIcon"
                                                Width="40"
                                                Height="40"
                                                VerticalAlignment="Center"
                                                Data="{StaticResource IconClock}"
                                                Fill="{TemplateBinding DigitBrush}"
                                                Stretch="Uniform" />
                                        </StackPanel>

                                        <!--  Unified Numerical Display Matrix Host with Minimum Width Constraint  -->
                                        <Grid
                                            Grid.Row="0"
                                            Grid.RowSpan="2"
                                            Grid.Column="1"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center">

                                            <!--  Ghost Inactive Segments Matrix  -->
                                            <TextBlock
                                                x:Name="PART_PlaceholderText"
                                                FontFamily="{StaticResource FontFamilyDigit}"
                                                FontSize="90"
                                                FontStretch="UltraExpanded"
                                                FontWeight="ExtraBold"
                                                Foreground="{TemplateBinding PlaceholderBrush}"
                                                Text="{TemplateBinding PlaceholderText}"
                                                TextAlignment="Right"
                                                TextOptions.TextFormattingMode="Display" />

                                            <!--  Active Illuminated Numerical Digits  -->
                                            <TextBlock
                                                x:Name="PART_TimeText"
                                                FontFamily="{StaticResource FontFamilyDigit}"
                                                FontSize="90"
                                                FontStretch="UltraExpanded"
                                                FontWeight="ExtraBold"
                                                Foreground="{TemplateBinding DigitBrush}"
                                                Text="{TemplateBinding TimeText}"
                                                TextAlignment="Right"
                                                TextOptions.TextFormattingMode="Display" />
                                        </Grid>
                                    </Grid>
                                </Border>

                                <!--  Section C: Footer Status Indicators  -->
                                <StackPanel
                                    x:Name="PART_StatePanel"
                                    Grid.Row="2"
                                    Margin="0,8,0,0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Visibility="{TemplateBinding IsStateVisible,
                                                                 Converter={StaticResource BooleanToVisibilityConverter}}">

                                    <TextBlock
                                        x:Name="PART_StateText"
                                        FontFamily="{StaticResource FontFamilyApp}"
                                        FontSize="16"
                                        FontWeight="SemiBold"
                                        Foreground="#90A4AE"
                                        Text="آماده" />
                                    <Ellipse
                                        x:Name="PART_StatusIndicator"
                                        Width="8"
                                        Height="8"
                                        Margin="6,0,0,0"
                                        VerticalAlignment="Center"
                                        Fill="#607D8B" />
                                </StackPanel>
                            </Grid>
                        </Border>

                    </Grid>

                    <!--  State Machine and Telemetry Triggers  -->
                    <ControlTemplate.Triggers>
                        <!--  Directional Trigger  -->
                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Direction}" Value="CountUp">
                            <Setter TargetName="PART_DirectionIcon" Property="Data" Value="{StaticResource IconTimerUp}" />
                        </DataTrigger>

                        <!--  Operational State Triggers  -->
                        <Trigger Property="State" Value="{x:Static models:TimerState.Running}">
                            <Setter TargetName="PART_StateText" Property="Text" Value="در حال شمارش" />
                            <Setter TargetName="PART_StateText" Property="Foreground" Value="#4CAF50" />
                            <Setter TargetName="PART_StatusIndicator" Property="Fill" Value="#4CAF50" />
                            <Setter TargetName="PART_StateIcon" Property="Data" Value="{StaticResource IconTimerRunning}" />
                            <!--<Setter TargetName="PART_StateIcon" Property="Fill" Value="#4CAF50" />-->
                        </Trigger>

                        <Trigger Property="State" Value="{x:Static models:TimerState.Pausing}">
                            <Setter TargetName="PART_StateText" Property="Text" Value="توقف" />
                            <Setter TargetName="PART_StateText" Property="Foreground" Value="#FFC107" />
                            <Setter TargetName="PART_StatusIndicator" Property="Fill" Value="#FFC107" />
                            <Setter TargetName="PART_StateIcon" Property="Data" Value="{StaticResource IconTimerPause}" />
                            <!--<Setter TargetName="PART_StateIcon" Property="Fill" Value="#FFC107" />-->
                        </Trigger>

                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
