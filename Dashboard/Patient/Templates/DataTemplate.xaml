<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:Simurgh.Dashboard.Core.Infrastructures.Behaviors"
    xmlns:controls="clr-namespace:Simurgh.Dashboard.Core.Controls"
    xmlns:converters="clr-namespace:Simurgh.Dashboard.Core.Infrastructures.Converters"
    xmlns:vm="clr-namespace:Simurgh.Dashboard.Patient.ViewModels">

    <!--  Merged Theme Resource Dictionaries  -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Simurgh.Dashboard;component/Core/Themes/Icons.xaml" />
        <ResourceDictionary Source="/Simurgh.Dashboard;component/Core/Themes/Fonts.xaml" />
        <ResourceDictionary Source="/Simurgh.Dashboard;component/Core/Themes/Images.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--  Boolean to Visibility Converter  -->
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

    <!--  Patient Demographic Dynamic & High-Contrast OR Display Template  -->
    <DataTemplate DataType="{x:Type vm:PatientDemographicViewModel}">

        <!--  LAYER 2: Dynamic Collapsible Content  -->
        <Grid
            Margin="-5,5"
            ClipToBounds="True"
            SnapsToDevicePixels="True"
            Visibility="{Binding IsAnyPropertyVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="1*" />
            </Grid.RowDefinitions>

            <controls:NineSliceBorder
                x:Name="PART_Frame"
                Grid.RowSpan="3"
                Margin="-10"
                IsHitTestVisible="False"
                SliceThickness="60"
                Source="{StaticResource ImgPanelRoundedRaised}" />
            <controls:NineSliceBorder
                x:Name="PART_Frame1"
                Grid.Row="3"
                Grid.RowSpan="2"
                Margin="-10,-5"
                IsHitTestVisible="False"
                SliceThickness="60"
                Source="{StaticResource ImgPanelRoundedRaised}" />
            <!--  =========================================================  -->
            <!--  SECTION 1: Header (Sex Icon + Accession + Patient ID)  -->
            <!--  =========================================================  -->

            <!--  Primary Identifier: Patient ID  -->
            <TextBlock
                Margin="30,20,20,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                FontFamily="{StaticResource FontFamilyApp}"
                FontSize="32"
                FontWeight="ExtraBold"
                Foreground="{Binding PrimaryBrush}"
                Text="{Binding PatientId}"
                TextTrimming="CharacterEllipsis"
                Visibility="{Binding IsPatientIdVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />


            <!--  =========================================================  -->
            <!--  SECTION 2: Patient Full Name (Large Headline)  -->
            <!--  =========================================================  -->
            <TextBlock
                Grid.Row="1"
                Margin="24,0"
                behaviors:TextBlockTrimmingBehavior.MaxLines="2"
                FlowDirection="RightToLeft"
                FontFamily="{StaticResource FontFamilyApp}"
                FontSize="38"
                FontWeight="ExtraBold"
                Foreground="{Binding PrimaryBrush}"
                LineHeight="44"
                LineStackingStrategy="BlockLineHeight"
                Text="{Binding FullName}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="Wrap"
                Visibility="{Binding IsFullNameVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />

            <!--  =========================================================  -->
            <!--  SECTION 3: Demographics (Age Badge & Birth Date)  -->
            <!--  =========================================================  -->

            <!--  High-Visibility Clinical Age Pill  -->
            <DockPanel
                Grid.Row="2"
                Margin="24"
                HorizontalAlignment="Stretch">
                <TextBlock
                    DockPanel.Dock="Right"
                    FlowDirection="RightToLeft"
                    FontFamily="{StaticResource FontFamilyApp}"
                    FontSize="28"
                    FontWeight="Bold"
                    Foreground="{Binding PrimaryBrush}"
                    Text="{Binding FormattedAge}" />
                <Path
                    Width="36"
                    Height="36"
                    Margin="8,0,2,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Data="{Binding Sex, Converter={converters:PatientSexIconConverter}}"
                    DockPanel.Dock="Left"
                    Fill="{Binding PrimaryBrush}"
                    Stretch="Uniform"
                    Visibility="{Binding IsSexVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </DockPanel>


            <!--  =========================================================  -->
            <!--  SECTION 4: Procedure & Physician Section  -->
            <!--  =========================================================  -->
            <StackPanel
                Grid.Row="3"
                Margin="20,4,20,40"
                Visibility="{Binding HasProcedureVisibility, Converter={StaticResource BooleanToVisibilityConverter}}">
                <!--  Procedure Name  -->
                <TextBlock
                    Margin="0,25"
                    behaviors:TextBlockTrimmingBehavior.MaxLines="2"
                    FlowDirection="RightToLeft"
                    FontFamily="{StaticResource FontFamilyApp}"
                    FontSize="30"
                    FontWeight="Bold"
                    Foreground="{Binding SecondaryBrush}"
                    LineHeight="36"
                    LineStackingStrategy="BlockLineHeight"
                    Text="{Binding ProcedureDisplay}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="Wrap"
                    Visibility="{Binding IsProcedureVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <!--  Performed Physician  -->
                <TextBlock
                    behaviors:TextBlockTrimmingBehavior.MaxLines="1"
                    FlowDirection="RightToLeft"
                    FontFamily="{StaticResource FontFamilyApp}"
                    FontSize="26"
                    FontWeight="Medium"
                    Foreground="{Binding SecondaryBrush}"
                    Text="{Binding PhysicianDisplay}"
                    TextTrimming="CharacterEllipsis"
                    Visibility="{Binding IsPhysicianVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </StackPanel>

            <!--  =========================================================  -->
            <!--  SECTION 5: Critical Clinical Alerts & Special Needs  -->
            <!--  =========================================================  -->
            <StackPanel
                Grid.Row="4"
                Margin="20,4,20,40"
                Visibility="{Binding HasClinicalVisibility, Converter={StaticResource BooleanToVisibilityConverter}}">

                <!--  Contrast Allergy Alert (CRITICAL RED BADGE)  -->
                <Border
                    Margin="0,0,0,6"
                    Padding="10,4"
                    Background="#D32F2F"
                    CornerRadius="6"
                    Visibility="{Binding IsContrastAllergiesVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock
                        behaviors:TextBlockTrimmingBehavior.MaxLines="3"
                        FlowDirection="RightToLeft"
                        FontFamily="{StaticResource FontFamilyApp}"
                        FontSize="24"
                        FontWeight="ExtraBold"
                        Foreground="#FFFFFF"
                        LineHeight="36"
                        LineStackingStrategy="BlockLineHeight"
                        Text="{Binding ContrastAllergiesDisplay}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="Wrap" />
                </Border>

                <!--  Medical Alert (CRITICAL AMBER/ORANGE BADGE)  -->
                <Border
                    Margin="0,0,0,6"
                    Padding="10,4"
                    Background="#E65100"
                    CornerRadius="6"
                    Visibility="{Binding IsMedicalAlertVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock
                        behaviors:TextBlockTrimmingBehavior.MaxLines="3"
                        FlowDirection="RightToLeft"
                        FontFamily="{StaticResource FontFamilyApp}"
                        FontSize="24"
                        FontWeight="ExtraBold"
                        Foreground="#FFFFFF"
                        LineHeight="36"
                        LineStackingStrategy="BlockLineHeight"
                        Text="{Binding MedicalAlertDisplay}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="Wrap" />
                </Border>

                <!--  Special Needs & Notes  -->
                <Border
                    Margin="0,0,0,4"
                    Padding="8,3"
                    Background="#1E88E5"
                    CornerRadius="4"
                    Visibility="{Binding IsSpecialNeedsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock
                        behaviors:TextBlockTrimmingBehavior.MaxLines="2"
                        FlowDirection="RightToLeft"
                        FontFamily="{StaticResource FontFamilyApp}"
                        FontSize="22"
                        FontWeight="Bold"
                        Foreground="#FFFFFF"
                        LineHeight="36"
                        LineStackingStrategy="BlockLineHeight"
                        Text="{Binding SpecialNeedsDisplay}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="Wrap" />
                </Border>

            </StackPanel>
            <!--  Patient Comment / General Remark  -->

            <TextBlock
                Grid.Row="5"
                VerticalAlignment="Bottom"
                behaviors:TextBlockTrimmingBehavior.MaxLines="2"
                FlowDirection="RightToLeft"
                FontFamily="{StaticResource FontFamilyApp}"
                FontSize="22"
                FontStyle="Oblique"
                FontWeight="Bold"
                Foreground="{Binding SecondaryBrush}"
                LineHeight="36"
                Text="{Binding PatientCommentDisplay}"
                TextAlignment="Center"
                TextTrimming="CharacterEllipsis"
                TextWrapping="Wrap"
                Visibility="{Binding IsPatientCommentVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />

        </Grid>

    </DataTemplate>

</ResourceDictionary>
