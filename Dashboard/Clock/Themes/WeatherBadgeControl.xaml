<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls1="clr-namespace:Simurgh.Dashboard.Clock.Controls">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Simurgh.Dashboard;component/Core/Themes/Icons.xaml" />
        <ResourceDictionary Source="/Simurgh.Dashboard;component/Core/Themes/Fonts.xaml" />
        <ResourceDictionary Source="/Simurgh.Dashboard;component/Core/Themes/Images.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style TargetType="{x:Type controls1:WeatherBadgeControl}">
        <Setter Property="Foreground" Value="#FF7D0000" />
        <Setter Property="MinWidth" Value="150" />
        <Setter Property="MinHeight" Value="72" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls1:WeatherBadgeControl}">
                    <Border Background="{TemplateBinding Background}" CornerRadius="10">
                        <Grid HorizontalAlignment="Left">
                            <DockPanel
                                x:Name="MainContent"
                                HorizontalAlignment="Left"
                                LastChildFill="True">
                                <TextBlock
                                    Width="50"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    DockPanel.Dock="Left"
                                    FontFamily="{StaticResource WeatherIconsFont}"
                                    FontSize="38"
                                    Foreground="{TemplateBinding Foreground}"
                                    Text="{TemplateBinding ConditionIcon}"
                                    TextAlignment="Center" />
                                <StackPanel Margin="5,0,0,0" VerticalAlignment="Center">
                                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontFamily="{StaticResource FontFamilyApp}"
                                            FontSize="26"
                                            FontWeight="SemiBold"
                                            Foreground="{TemplateBinding Foreground}"
                                            Language="fa-IR"
                                            NumberSubstitution.CultureSource="Text"
                                            NumberSubstitution.Substitution="NativeNational"
                                            Text="{TemplateBinding Temperature}"
                                            Visibility="{TemplateBinding TemperatureVisibility}" />

                                        <TextBlock
                                            Margin="8,2,0,0"
                                            VerticalAlignment="Center"
                                            FontFamily="{StaticResource FontFamilyApp}"
                                            FontSize="12"
                                            Foreground="{TemplateBinding Foreground}"
                                            Language="fa-IR"
                                            NumberSubstitution.CultureSource="Text"
                                            NumberSubstitution.Substitution="NativeNational"
                                            Opacity="0.88"
                                            Text="{TemplateBinding ConditionText}"
                                            Visibility="{TemplateBinding ConditionTextVisibility}" />
                                    </StackPanel>

                                    <WrapPanel Margin="0,5,0,0" VerticalAlignment="Center">
                                        <Border
                                            x:Name="HumidityChip"
                                            Margin="0,0,6,4"
                                            Padding="7,2"
                                            Background="#22FFFFFF"
                                            CornerRadius="6"
                                            Visibility="{TemplateBinding HumidityVisibility}">
                                            <TextBlock
                                                FontFamily="{StaticResource FontFamilyApp}"
                                                FontSize="11"
                                                Foreground="{TemplateBinding Foreground}"
                                                Language="fa-IR"
                                                NumberSubstitution.CultureSource="Text"
                                                NumberSubstitution.Substitution="NativeNational"
                                                Text="{TemplateBinding Humidity}" />
                                        </Border>

                                        <Border
                                            x:Name="WindChip"
                                            Margin="0,0,6,4"
                                            Padding="7,2"
                                            Background="#22FFFFFF"
                                            CornerRadius="6"
                                            Visibility="{TemplateBinding WindVisibility}">
                                            <TextBlock
                                                FontFamily="{StaticResource FontFamilyApp}"
                                                FontSize="11"
                                                Foreground="{TemplateBinding Foreground}"
                                                Language="fa-IR"
                                                NumberSubstitution.CultureSource="Text"
                                                NumberSubstitution.Substitution="NativeNational"
                                                Text="{TemplateBinding Wind}" />
                                        </Border>
                                    </WrapPanel>
                                </StackPanel>
                            </DockPanel>

                            <Border x:Name="LoadingOverlay" Visibility="Collapsed">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource FontFamilyApp}"
                                    FontSize="16"
                                    FontWeight="ExtraBold"
                                    Foreground="#CC0F172A"
                                    Language="fa-IR"
                                    NumberSubstitution.CultureSource="Text"
                                    NumberSubstitution.Substitution="NativeNational"
                                    Text="بارگذاری" />
                            </Border>

                            <Border x:Name="ErrorOverlay" Visibility="Collapsed">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource FontFamilyApp}"
                                    FontSize="16"
                                    FontWeight="ExtraBold"
                                    Foreground="#CC7F1D1D"
                                    Language="fa-IR"
                                    NumberSubstitution.CultureSource="Text"
                                    NumberSubstitution.Substitution="NativeNational"
                                    Text="عدم دسترسی" />
                            </Border>
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsLoading" Value="True">
                            <Setter TargetName="LoadingOverlay" Property="Visibility" Value="Visible" />
                            <Setter TargetName="MainContent" Property="Visibility" Value="Collapsed" />
                        </Trigger>

                        <!--  Handle Error State: Show error text and hide main content  -->
                        <Trigger Property="HasError" Value="True">
                            <Setter TargetName="ErrorOverlay" Property="Visibility" Value="Visible" />
                            <Setter TargetName="MainContent" Property="Visibility" Value="Collapsed" />
                        </Trigger>

                        <Trigger Property="HumidityVisibility" Value="Collapsed">
                            <Setter TargetName="HumidityChip" Property="Margin" Value="0" />
                        </Trigger>

                        <Trigger Property="WindVisibility" Value="Collapsed">
                            <Setter TargetName="WindChip" Property="Margin" Value="0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
