<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Simurgh.Dashboard.Clock.Controls"
    xmlns:controls1="clr-namespace:Simurgh.Dashboard.Core.Controls">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Simurgh.Dashboard;component/Core/Themes/Icons.xaml" />
        <ResourceDictionary Source="/Simurgh.Dashboard;component/Core/Themes/Fonts.xaml" />
        <ResourceDictionary Source="/Simurgh.Dashboard;component/Core/Themes/Images.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style TargetType="{x:Type controls:DigitalClockControl}">

        <Setter Property="Padding" Value="40" />

        <Setter Property="VerticalContentAlignment" Value="Center" />

        <Setter Property="HorizontalContentAlignment" Value="Stretch" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:DigitalClockControl}">

                    <Grid HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}">

                        <controls1:NineSliceBorder
                            x:Name="PART_Frame"
                            Margin="-25"
                            IsHitTestVisible="False"
                            RenderOptions.BitmapScalingMode="Fant"
                            SliceThickness="60"
                            Source="{StaticResource ImgPanelRoundedRaised}" />

                        <Grid
                            Margin="{TemplateBinding Padding}"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch">

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!--  Clock and weather content  -->

                            <Border
                                Padding="15,15"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                Background="#CC000000"
                                BorderBrush="#33FFFFFF"
                                BorderThickness="1"
                                CornerRadius="15">

                                <Grid
                                    MinWidth="450"
                                    HorizontalAlignment="Stretch"
                                    ClipToBounds="False">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="1*" />
                                        <ColumnDefinition Width="140" />
                                    </Grid.ColumnDefinitions>

                                    <!--  Ghost clock digits  -->
                                    <TextBlock
                                        Grid.Column="1"
                                        Grid.ColumnSpan="2"
                                        Padding="4"
                                        FontFamily="{StaticResource FontFamilyDigit}"
                                        FontSize="140"
                                        FontStretch="UltraExpanded"
                                        FontWeight="ExtraBold"
                                        Foreground="{TemplateBinding PlaceholderBrush}"
                                        SnapsToDevicePixels="True"
                                        Text="88:88:88"
                                        TextAlignment="Right"
                                        TextOptions.TextFormattingMode="Display"
                                        TextOptions.TextRenderingMode="ClearType" />

                                    <!--  Current time  -->
                                    <TextBlock
                                        x:Name="PART_TimeText"
                                        Grid.Column="1"
                                        Grid.ColumnSpan="2"
                                        Padding="4"
                                        FontFamily="{StaticResource FontFamilyDigit}"
                                        FontSize="140"
                                        FontStretch="UltraExpanded"
                                        FontWeight="ExtraBold"
                                        Foreground="{TemplateBinding DigitBrush}"
                                        SnapsToDevicePixels="True"
                                        Text="{TemplateBinding TimeText}"
                                        TextAlignment="Right"
                                        TextOptions.TextFormattingMode="Display"
                                        TextOptions.TextRenderingMode="ClearType" />

                                    <!--  Weather badge  -->
                                    <controls:WeatherBadgeControl
                                        Height="Auto"
                                        HorizontalAlignment="left"
                                        VerticalAlignment="Top"
                                        Background="Transparent"
                                        ConditionIcon="{Binding Path=WeatherState.ConditionIcon, RelativeSource={RelativeSource TemplatedParent}}"
                                        ConditionText="{Binding Path=WeatherState.ConditionText, RelativeSource={RelativeSource TemplatedParent}}"
                                        ConditionTextVisibility="Collapsed"
                                        FontSize="18"
                                        Foreground="{TemplateBinding DigitBrush}"
                                        HasError="{Binding Path=WeatherState.HasError, RelativeSource={RelativeSource TemplatedParent}}"
                                        Humidity="{Binding Path=WeatherState.Humidity, RelativeSource={RelativeSource TemplatedParent}}"
                                        HumidityVisibility="Collapsed"
                                        IsLoading="{Binding Path=WeatherState.IsLoading, RelativeSource={RelativeSource TemplatedParent}}"
                                        Temperature="{Binding Path=WeatherState.Temperature, RelativeSource={RelativeSource TemplatedParent}}"
                                        TemperatureVisibility="Visible"
                                        Wind="{Binding Path=WeatherState.Wind, RelativeSource={RelativeSource TemplatedParent}}"
                                        WindVisibility="Collapsed" />
                                </Grid>
                            </Border>





                            <!--  Jalali date  -->
                            <TextBlock
                                x:Name="PART_DateText"
                                Grid.Row="1"
                                Margin="0,10,0,0"
                                HorizontalAlignment="Center"
                                FlowDirection="RightToLeft"
                                FontFamily="{StaticResource FontFamilyApp}"
                                FontSize="80"
                                FontWeight="ExtraBold"
                                Foreground="{TemplateBinding DateBrush}"
                                Language="fa-IR"
                                NumberSubstitution.CultureSource="Text"
                                NumberSubstitution.Substitution="NativeNational"
                                SnapsToDevicePixels="True"
                                Text="{TemplateBinding DateText}"
                                TextAlignment="Center"
                                TextOptions.TextFormattingMode="Display"
                                TextOptions.TextRenderingMode="ClearType"
                                TextWrapping="Wrap" />

                        </Grid>
                    </Grid>

                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
